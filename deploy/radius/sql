# -*- text -*-
#
#  Modul SQL FreeRADIUS untuk generator_mikrotik (menggantikan mods-enabled/sql).
#  Kredensial dibaca dari environment (deploy/radius/.env, lihat .env.example).

sql {
	dialect = "mysql"
	driver = "rlm_sql_${dialect}"

	server = $ENV{RADIUS_DB_HOST}
	port = $ENV{RADIUS_DB_PORT}
	login = $ENV{RADIUS_DB_USER}
	password = $ENV{RADIUS_DB_PASSWORD}
	radius_db = $ENV{RADIUS_DB_NAME}

	#  Kecepatan diambil langsung dari paket lewat view radius_reply, jadi grup RADIUS tidak dipakai.
	read_groups = no

	#  Daftar CHR dari view radius_nas. Dibaca sekali saat mulai: setelah menambah server VPN,
	#  jalankan `docker restart mikrosetting-radius`.
	read_clients = yes

	delete_stale_sessions = yes

	pool {
		start = 2
		min = 1
		max = 10
		spare = 3
		uses = 0
		retry_delay = 30
		lifetime = 0
		idle_timeout = 60
	}

	$INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
