# -*- text -*-
#
#  Virtual server FreeRADIUS untuk akun VPN pelanggan (menggantikan sites-enabled/default).
#  Hanya PPP dari CHR: MS-CHAPv2 (SSTP/L2TP) dan PAP (OVPN), diperiksa terhadap NT-Password.

server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}

	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		preprocess
		mschap
		sql
		#  Tidak ada baris di radius_check: akun tidak ada, tidak aktif, habis masa aktif,
		#  atau mencoba login lewat server lain.
		if (notfound) {
			reject
		}
		pap
	}

	authenticate {
		Auth-Type PAP {
			pap
		}
		Auth-Type MS-CHAP {
			mschap
		}
	}

	preacct {
		preprocess
		acct_unique
	}

	accounting {
		sql
	}

	#  Simultaneous-Use (satu akun satu sesi) dihitung dari radacct.
	session {
		sql
	}

	post-auth {
		Post-Auth-Type REJECT {
			attr_filter.access_reject
		}
	}
}
