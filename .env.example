# Salin ke .env dan isi nilai sebenarnya. .env tidak ikut di-commit (lihat .gitignore).

# Koneksi MySQL — buat database & user lewat aaPanel (Database → Add database),
# lalu isi kredensialnya di sini.
DATABASE_URL="mysql://user:password@127.0.0.1:3306/generator_mikrotik"

# Kunci enkripsi sesi NextAuth — generate sekali dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-acak-panjang"

# URL publik situs — wajib diisi benar di production supaya redirect login
# dan callback NextAuth tidak salah alamat di belakang reverse proxy Nginx.
NEXTAUTH_URL="https://generator.mikrosetting.com"

# Dipakai sekali oleh `npm run db:seed` untuk membuat akun admin pertama.
# Ganti password-nya lewat panel admin (/admin/users) setelah login pertama kali.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ganti-password-ini"
