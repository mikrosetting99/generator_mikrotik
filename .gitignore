# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bahan rujukan lokal (template hotspot milik pelanggan, dsb)
/_contoh-hotspot/

# Arsip hasil cetak login page (berisi kunci lisensi pelanggan)
/data/hasil/

# Latar bawaan tema: sebagian memakai karya resmi pihak lain (Naruto,
# Mobile Legends). Repo ini publik, jadi gambarnya tidak ikut. Unggah
# manual ke templates/<tema>/img/bg.jpg di server lewat File Manager
# aaPanel; tanpa berkas itu temanya jatuh ke hiasan SVG bawaannya dan
# tetap berfungsi.
templates/*/img/*.jpg
templates/*/img/*.png
