# Salin ke deploy/radius/.env. File .env tidak ikut di-commit.

# Database aplikasi generator (tempat view radius_* dan tabel radacct).
RADIUS_DB_HOST=127.0.0.1
RADIUS_DB_PORT=3306
RADIUS_DB_NAME=generator_mikrotik
# User MySQL khusus FreeRADIUS (lihat README.md bagian 2), bukan user aplikasi.
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=

# Secret untuk uji radtest dari server ini saja (client localhost). Isi string acak.
RADIUS_TEST_SECRET=
