# Supabase — dipakai HANYA oleh bagian /lisensi (login penerbit dan riwayat
# pesanan). Generator setup MikroTik di /setup tidak menyentuh ini sama sekali
# dan tetap jalan walau kosong.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resep rahasia pembuat kunci lisensi. HARUS sama persis dengan LIS_SALT di
# dalam login.html yang sudah beredar — kalau diubah, SEMUA kunci yang pernah
# diterbitkan langsung mati dan tidak bisa ditarik kembali dari router pembeli.
#
# Hanya dibaca di sisi server (route handler dan server action), tidak pernah
# ikut ke browser. Jangan pernah diberi awalan NEXT_PUBLIC_, dan jangan dikomit.
MSLP_LICENSE_SALT=

# Nomor WhatsApp penerbit lisensi (62..., tanpa +). Tujuan tombol di layar
# "LISENSI TIDAK AKTIF" — nomor Anda, bukan nomor pembeli.
MSLP_LICENSOR_WA=6281112001036
