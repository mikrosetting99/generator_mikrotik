// Prisma schema — database MySQL untuk riwayat konfigurasi Setup Mikrotik Baru.
// Setelah mengubah file ini di server: npx prisma migrate deploy

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  configs     SavedConfig[]
  loginPages  SavedLoginPage[]
  aiRouters   AiRouter[]
  vpnAccounts VpnAccount[]
  nmDevices   NmDevice[]

  @@map("users")
}

/// Perangkat yang dipantau Network Monitoring. Kredensial (sebaiknya user read-only) terenkripsi
/// lewat lib/vault.ts dan hanya dibuka oleh collector; tidak pernah dikirim ke browser.
model NmDevice {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String    @db.VarChar(80)
  site           String    @default("") @db.VarChar(80)
  /// router | olt | ap | onu | server
  kind           String    @default("router") @db.VarChar(12)
  /// mikrotik dipantau collector Tahap 1; vendor lain tercatat tetapi datanya "Tidak tersedia".
  vendor         String    @default("mikrotik") @db.VarChar(20)
  host           String    @default("") @db.VarChar(253)
  apiPort        Int       @default(8728)
  tls            Boolean   @default(false)
  /// SHA-256 sertifikat API-SSL yang dipercaya (untuk sertifikat self-signed); kosong = wajib CA valid.
  tlsFingerprint String    @default("") @db.VarChar(100)
  username       String    @default("") @db.VarChar(100)
  passwordEnc    String    @db.Text
  enabled        Boolean   @default(true)
  intervalSec    Int       @default(60)
  /// Nama interface WAN yang dipantau, dipisah koma.
  wanInterfaces  String    @default("") @db.VarChar(500)
  /// Ambang aturan Analisa (lib/nm/types.ts RuleConfig); null = bawaan.
  rules          Json?
  /// Diklaim collector sebelum polling (mencegah dua worker memeriksa perangkat yang sama).
  lastPollAt     DateTime?
  lastSampleAt   DateTime?
  /// Ringkasan sampel terakhir untuk daftar (tanpa kredensial).
  state          Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  samples  NmSample[]
  findings NmFinding[]

  @@index([userId])
  @@index([enabled, lastPollAt])
  @@map("nm_devices")
}

/// Satu pemeriksaan perangkat oleh collector. Trafik WAN dihitung dari selisih counter antar sampel.
model NmSample {
  id        BigInt   @id @default(autoincrement())
  deviceId  String
  device    NmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  at        DateTime @db.DateTime(3)
  reachable Boolean
  apiOk     Boolean
  cpu       Int?
  memPct    Float?
  uptimeSec Int?
  ppp       Int?
  hotspot   Int?
  /// [{name, found, running, rxByte, txByte, rxBps, txBps}]
  wan       Json?
  error     String   @default("") @db.VarChar(300)

  @@index([deviceId, at])
  @@index([at])
  @@map("nm_samples")
}

/// Temuan Analisa. activeKey terisi selama aktif (unik per perangkat+aturan+interface) dan dikosongkan
/// saat pulih, jadi retry atau worker paralel tidak bisa membuat temuan aktif ganda.
model NmFinding {
  id           String    @id @default(cuid())
  userId       String
  deviceId     String
  device       NmDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rule         String    @db.VarChar(24)
  subject      String    @default("") @db.VarChar(80)
  activeKey    String?   @unique @db.VarChar(200)
  /// active | resolved
  status       String    @default("active") @db.VarChar(10)
  summary      String    @db.VarChar(300)
  triggerValue String    @db.VarChar(200)
  evidence     Json
  recovery     String    @default("") @db.VarChar(300)
  startedAt    DateTime  @db.DateTime(3)
  lastSeenAt   DateTime  @db.DateTime(3)
  resolvedAt   DateTime? @db.DateTime(3)

  @@index([userId, status])
  @@index([deviceId, startedAt])
  @@map("nm_findings")
}

/// Detak collector: bila berhenti, data perangkat ditandai kedaluwarsa.
model NmCollector {
  id         String   @id @db.VarChar(64)
  startedAt  DateTime @db.DateTime(3)
  lastBeatAt DateTime @db.DateTime(3)
  info       Json?

  @@map("nm_collectors")
}

/// Mikrotik milik pengguna untuk menu AI Mikrotik Engineer. Password disimpan terenkripsi (lib/vault.ts)
/// dan tidak pernah dikirim balik ke browser.
model AiRouter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(80)
  host        String   @db.VarChar(253)
  /// "api" (RouterOS API, bawaan) atau "ssh".
  protocol    String   @default("api") @db.VarChar(8)
  /// Port API; 0 = API tidak dipakai.
  port        Int      @default(8728)
  /// Port SSH; 0 = SSH tidak dipakai. `protocol` menjadi pilihan bawaan bila keduanya aktif.
  sshPort     Int      @default(0)
  tls         Boolean  @default(false)
  username    String   @db.VarChar(100)
  passwordEnc String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("ai_routers")
}

/// Satu baris = satu konfigurasi Setup Mikrotik Baru yang disimpan pengguna.
/// Beberapa baris dengan nama sama dari pengguna yang sama = riwayat versi.
model SavedConfig {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  config     Json
  hasSecrets Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("saved_configs")
}

/// Satu baris = satu desain Halaman Login Hotspot yang disimpan pengguna.
/// Gambar (logo, latar, latar form) ikut tersimpan sebagai data URI di dalam JSON.
model SavedLoginPage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_login_pages")
}

/// Pengaturan situs yang diubah admin lewat /admin (mis. tampilan halaman utama).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// Penghitung berapa kali sebuah menu dibuka (analitik sederhana, tanpa data pribadi).
model MenuUsage {
  menuId    String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("menu_usage")
}

/// Pemakaian menu per hari (tanggal WIB, "YYYY-MM-DD"), untuk tren di Dashboard Admin. Tanpa data pribadi.
model MenuUsageDaily {
  menuId String @db.VarChar(64)
  day    String @db.Char(10)
  count  Int    @default(0)

  @@id([menuId, day])
  @@index([day])
  @@map("menu_usage_daily")
}

/// Template Halaman Login Hotspot yang sudah jadi: dibuat admin, bisa dimuat siapa saja.
/// Config memuat seluruh pengaturan desain, termasuk gambar (data URI).
model HotspotTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  /// Ringkasan untuk daftar (tanpa memuat config besar): jenis desain dan dua warna utama.
  design       String   @default("minimal")
  primaryColor String   @default("#38bdf8")
  bgColor      String   @default("#eef2f7")
  /// Template yang dimuat pertama kali saat siapa pun membuka Halaman Login Hotspot (maks satu).
  isDefault    Boolean  @default(false)
  config       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("hotspot_templates")
}

/// Galeri latar siap pakai yang diunggah admin untuk Halaman Login Hotspot.
/// Pengguna tinggal memilih, atau tetap bisa mengunggah latar sendiri.
model BackgroundPreset {
  id        String   @id @default(cuid())
  /// "background" (latar) atau "logo" — satu galeri, dua jenis.
  kind      String   @default("background")
  name      String
  mime      String
  size      Int
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now())

  @@index([kind])
  @@map("background_presets")
}

enum LicenseStatus {
  draft
  terkirim
  aktif
  batal
}

/// Satu baris = satu pesanan Login Page Hotspot (menu /login-page-hotspot).
/// Dulu di Supabase (license_orders); dipindah ke sini bersama sistem login
/// yang sama dengan Setup Mikrotik Baru, tanpa sistem koin/pembayaran lagi.
model LicenseOrder {
  id    String @id @default(cuid())
  /// Nomor pendek untuk disebut di percakapan WhatsApp ("pesanan #14").
  nomor Int    @unique @default(autoincrement())

  namaUsaha    String
  kontakNama   String?
  catatan      String?
  templateSlug String

  // Logo teks dipecah dua supaya bisa dua warna, seperti MIKRO|SETTING.
  merekA        String
  merekB        String  @default("")
  merekSpasi    Boolean @default(true)
  tagline       String  @default("INTERNET HOTSPOT VOUCHER")
  footerTagline String  @default("Internet Hotspot Voucher")

  // waNomor untuk tautan (62...), waTampil untuk yang terbaca di layar.
  waNomor  String
  waTampil String

  /// Kunci slot warna -> #rrggbb; kosong berarti pakai bawaan tema.
  warna Json?

  bankNama     String?
  bankNomor    String?
  bankAtasNama String?

  // Gambar disimpan sebagai data URI, lalu ditulis jadi berkas img/logo.png
  // dan img/bg.jpg di dalam zip. Halaman login tidak boleh menunjuk ke alamat
  // luar: pelanggan belum punya internet saat membukanya.
  logoDataUrl String? @db.LongText
  bgDataUrl   String? @db.LongText

  // Diisi setelah pembeli melaporkan ID ROUTER dari layar "LISENSI TIDAK AKTIF".
  routerIdentity    String?
  lisensiKunci      String?
  lisensiTerbitPada DateTime?

  status LicenseStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packages LicensePackage[]

  @@index([status, createdAt])
  @@map("license_orders")
}

model LicensePackage {
  id      String       @id @default(cuid())
  orderId String
  order   LicenseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  posisi    Int     @default(0)
  nama      String
  harga     String
  metaAtas  String  @default("Masa aktif")
  metaBawah String  @default("")
  warna     String  @default("#3ea6ff")
  /// Pita tingkatan khas tema (KAGE, MYTHIC, ...). Kosong = pakai bawaan tema.
  rank      String?

  @@index([orderId, posisi])
  @@map("license_packages")
}

/// Kategori script pelanggan (mis. Mikhmon online, VPN Remote). Hanya admin yang mengelola.
model VpnCategory {
  id        String      @id @default(cuid())
  name      String      @unique @db.VarChar(80)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  scripts   VpnScript[]

  @@map("vpn_categories")
}

/// Satu link script untuk pelanggan: dibuka lewat /script/<token> dan dikunci dengan nomor HP.
/// Password dan isi script disimpan terenkripsi (lib/vault.ts).
model VpnScript {
  id          String      @id @default(cuid())
  /// Bagian acak di link pelanggan; tidak bisa ditebak.
  token       String      @unique @db.VarChar(40)
  /// Nomor HP ternormalisasi (62812...). Satu nomor boleh punya banyak link.
  phone       String      @db.VarChar(20)
  customer    String      @default("") @db.VarChar(120)
  categoryId  String
  category    VpnCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String      @db.VarChar(160)
  username    String      @default("") @db.VarChar(160)
  passwordEnc String      @db.Text
  scriptEnc   String      @db.LongText
  note        String      @default("") @db.VarChar(500)
  /// Tipe script VPN yang dibuat otomatis: "sstp", "l2tp", "ovpn", atau "" (script manual di scriptEnc).
  protocol    String      @default("") @db.VarChar(10)
  /// Tipe yang boleh dipilih pelanggan, dipisah koma (mis. "sstp,l2tp,ovpn"); kosong = ketiganya.
  offered     String      @default("") @db.VarChar(20)
  rosVersion  String      @default("v6") @db.VarChar(4)
  vpnServer   String      @default("") @db.VarChar(160)
  gatewayIp   String      @default("") @db.VarChar(45)
  tunnelName  String      @default("") @db.VarChar(80)
  vpnPort     Int         @default(0)
  ipsecEnc    String      @default("") @db.VarChar(400)
  /// Alamat akses router untuk pelanggan: Winbox, API, dan link Mikhmon online.
  winbox      String      @default("") @db.VarChar(200)
  api         String      @default("") @db.VarChar(200)
  mikhmonUrl  String      @default("") @db.VarChar(300)
  /// Kategori VPN Remote: IP tunnel pelanggan dan port-forward dst-nat (JSON [{port,toAddress,toPort}]).
  tunnelIp    String      @default("") @db.VarChar(45)
  natRules    String      @default("") @db.VarChar(1500)
  /// IP publik server VPN untuk alamat akses VPN Remote; kosong = bawaan bila server bawaan.
  publicIp    String      @default("") @db.VarChar(45)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([phone])
  @@index([categoryId])
  @@map("vpn_scripts")
}

/// Server VPN (Mikrotik CHR) yang memeriksa login pelanggan ke FreeRADIUS. Setiap server punya
/// subnet tunnel sendiri; IP pelanggan dibagikan dari subnet itu (lib/vpn-radius.ts).
model VpnServer {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(80)
  location     String       @default("") @db.VarChar(80)
  /// Alamat yang dipakai pelanggan (connect-to dan akses), mis. vpn1.mikrosetting.com.
  domain       String       @unique @db.VarChar(160)
  /// IP publik CHR; FreeRADIUS mengenali server dari IP asal paket ini (view radius_nas).
  publicIp     String       @unique @db.VarChar(15)
  subnet       String       @db.VarChar(18)
  /// local-address profil PPP di CHR; dipantau Netwatch di script pelanggan.
  gatewayIp    String       @db.VarChar(15)
  /// Protokol yang aktif di server, dipisah koma (mis. "sstp,l2tp,ovpn").
  protocols    String       @default("sstp,l2tp,ovpn") @db.VarChar(20)
  rosVersion   String       @default("v6") @db.VarChar(4)
  capacity     Int          @default(250)
  /// Secret RADIUS apa adanya: FreeRADIUS harus bisa membacanya (lewat view radius_nas).
  radiusSecret String       @db.VarChar(64)
  /// false = semua akun di server ini ditolak RADIUS.
  active       Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  accounts     VpnAccount[]

  @@map("vpn_servers")
}

/// Paket VPN yang dibuat admin: harga, masa aktif, kecepatan, dan kuota.
model VpnPackage {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(80)
  priceIdr     Int          @default(0)
  durationDays Int          @default(30)
  /// Batas kecepatan pelanggan dalam kbps; 0 = tanpa batas (Mikrotik-Rate-Limit lewat view radius_reply).
  uploadKbps   Int          @default(0)
  downloadKbps Int          @default(0)
  /// Port-forward tambahan di luar Winbox/API/Webfig bawaan.
  portForwards Int          @default(0)
  /// Maksimal akun VPN per pelanggan di paket ini.
  maxAccounts  Int          @default(1)
  protocols    String       @default("sstp,l2tp,ovpn") @db.VarChar(20)
  /// Id server yang boleh dipilih, dipisah koma; kosong = semua server.
  serverIds    String       @default("") @db.VarChar(1000)
  active       Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  accounts     VpnAccount[]

  @@map("vpn_packages")
}

/// Satu akun VPN pelanggan, terikat ke satu server dan satu paket. FreeRADIUS hanya menerima akun
/// berstatus "active" yang belum lewat expiresAt (view radius_check).
model VpnAccount {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId    String
  server      VpnServer  @relation(fields: [serverId], references: [id], onDelete: Restrict)
  packageId   String
  package     VpnPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  username    String     @unique @db.VarChar(41)
  /// Terenkripsi (lib/vault.ts), untuk ditampilkan di script pelanggan.
  passwordEnc String     @db.Text
  /// NT-Password (lib/nt-hash.ts) yang dibaca FreeRADIUS; password asli tidak pernah sampai ke RADIUS.
  ntHash      String     @db.Char(32)
  /// IP tetap pelanggan di dalam tunnel (Framed-IP-Address).
  tunnelIp    String     @db.VarChar(15)
  /// "pending" | "active" | "suspended"
  status      String     @default("pending") @db.VarChar(12)
  /// null = tanpa batas waktu.
  expiresAt   DateTime?
  note        String     @default("") @db.VarChar(300)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([serverId, tunnelIp])
  @@index([userId])
  @@index([packageId])
  @@map("vpn_accounts")
}

/// Accounting FreeRADIUS (ditulis FreeRADIUS, dibaca aplikasi untuk status online dan pemakaian).
/// Kolomnya hanya yang dipakai deploy/radius/queries.conf; waktu dalam UTC.
model RadAcct {
  radacctid          BigInt    @id @default(autoincrement())
  acctsessionid      String    @default("") @db.VarChar(64)
  acctuniqueid       String    @unique @default("") @db.VarChar(32)
  username           String    @default("") @db.VarChar(64)
  nasipaddress       String    @default("") @db.VarChar(15)
  nasportid          String?   @db.VarChar(32)
  acctstarttime      DateTime? @db.DateTime(0)
  acctupdatetime     DateTime? @db.DateTime(0)
  acctstoptime       DateTime? @db.DateTime(0)
  acctsessiontime    Int?      @db.UnsignedInt
  acctinputoctets    BigInt?
  acctoutputoctets   BigInt?
  callingstationid   String    @default("") @db.VarChar(50)
  acctterminatecause String    @default("") @db.VarChar(32)
  framedipaddress    String    @default("") @db.VarChar(15)

  @@index([username])
  @@index([acctstoptime])
  @@index([nasipaddress])
  @@index([framedipaddress])
  @@index([acctsessionid])
  @@map("radacct")
}
