# Supabase — dipakai HANYA oleh bagian /lisensi (login penerbit dan riwayat
# pesanan). Generator setup MikroTik di /setup tidak menyentuh ini sama sekali
# dan tetap jalan walau kosong.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resep rahasia pembuat kunci lisensi. HARUS sama persis dengan LIS_SALT di
# dalam login.html yang sudah beredar — kalau diubah, SEMUA kunci yang pernah
# diterbitkan langsung mati dan tidak bisa ditarik kembali dari router pembeli.
#
# Hanya dibaca di sisi server (route handler dan server action), tidak pernah
# ikut ke browser. Jangan pernah diberi awalan NEXT_PUBLIC_, dan jangan dikomit.
MSLP_LICENSE_SALT=

# Nomor WhatsApp penerbit lisensi (62..., tanpa +). Tujuan tombol di layar
# "LISENSI TIDAK AKTIF" — nomor Anda, bukan nomor pembeli.
MSLP_LICENSOR_WA=6281112001036

# --- Pembayaran koin (Duitku) ----------------------------------------------
# Dari dashboard Duitku > Project. Keduanya rahasia dan hanya dibaca di server.
# API key adalah bukti keaslian callback: siapa pun yang memegangnya bisa
# memalsukan "pembayaran berhasil" dan menambah koin tanpa membayar.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=

# sandbox untuk uji coba, production untuk transaksi sungguhan.
DUITKU_ENV=sandbox

# Alamat aplikasi tanpa garis miring di akhir. Dipakai menyusun URL callback
# dan URL kembali yang dikirim ke Duitku, jadi harus alamat yang benar-benar
# bisa dijangkau dari internet -- localhost tidak akan menerima callback.
NEXT_PUBLIC_APP_URL=https://mkgenerator.mikrosetting.com

# Service role Supabase, dari Project Settings > API. Dipakai HANYA oleh
# callback Duitku, yang datang tanpa sesi pengguna sehingga tidak bisa lewat
# RLS. Kunci ini melewati seluruh RLS -- jangan pernah diberi awalan
# NEXT_PUBLIC_, jangan dikomit, dan jangan dipakai di luar callback.
SUPABASE_SERVICE_ROLE_KEY=

# Biaya satu pesanan login page, dalam koin.
MSLP_BIAYA_PESANAN=25
